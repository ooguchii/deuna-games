{
  "name": "deuna-games",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "lan": "next dev --hostname 0.0.0.0 --port 3000",
    "lan:prod": "npm run build && next start --hostname 0.0.0.0 --port 3000",
    "lan:doctor": "node ./tools/lan-doctor.mjs",
    "mobile": "npm run lan",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:source": "node ./tools/check-source-hygiene.mjs",
    "check:encoding": "node ./tools/check-text-encoding.mjs",
    "check:privacy": "node ./tools/check-public-privacy.mjs",
    "check:data": "node ./tools/check-data.mjs",
    "check:assets": "node ./tools/check-assets.mjs",
    "check:routes": "node ./tools/check-routes.mjs",
    "check:css-vars": "node ./tools/check-css-vars.mjs",
    "check:css-modules": "node ./tools/check-css-modules.mjs",
    "smoke": "node ./tools/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:source && npm run check:encoding && npm run check:privacy && npm run check:data && npm run check:assets && npm run check:routes && npm run check:css-vars && npm run check:css-modules && npm run build && npm run smoke",
    "audit:deps": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:scan": "node ./tools/security-audit.mjs",
    "images:strip-metadata": "node ./tools/strip-webp-metadata.mjs",
    "build:secure": "node ./tools/build-secure-deploy.mjs"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "typescript": "^5"
  }
}
