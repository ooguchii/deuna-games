{
  "name": "deuna-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ./tools/run-next.mjs dev --hostname 127.0.0.1 --port 3000",
    "lan": "node ./tools/run-next.mjs dev --hostname 0.0.0.0 --port 3000",
    "lan:prod": "npm run build && node ./tools/run-next.mjs start --hostname 0.0.0.0 --port 3000",
    "lan:doctor": "node ./tools/lan-doctor.mjs",
    "mobile": "npm run lan",
    "local:setup": "bash ./tools/setup-local-server.sh",
    "dev:webpack": "node ./tools/run-next.mjs dev --webpack --hostname 127.0.0.1 --port 3000",
    "db:migrate": "node --env-file=.env.admin-migration.local ./tools/admin/migrate.ts",
    "admin:import-content": "node --env-file=.env.admin-migration.local ./tools/admin/import-content.ts",
    "admin:create-owner": "node --env-file=.env.admin-migration.local ./tools/admin/create-owner.ts",
    "admin:setup": "npm run db:migrate && npm run admin:import-content && npm run admin:create-owner",
    "admin:preflight:migration": "node --env-file=.env.admin-migration.local ./tools/admin/preflight.ts --purpose=migration",
    "admin:preflight:runtime": "node --env-file=.env.local ./tools/admin/preflight.ts --purpose=runtime",
    "admin:preflight": "npm run admin:preflight:migration && npm run admin:preflight:runtime",
    "build": "node ./tools/run-next.mjs build",
    "start": "node ./tools/run-next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node ./tools/check-architecture.mjs",
    "check:source": "node ./tools/check-source-hygiene.mjs",
    "check:encoding": "node ./tools/check-text-encoding.mjs",
    "check:privacy": "node ./tools/check-public-privacy.mjs",
    "check:admin-security": "node ./tools/check-admin-security.ts",
    "check:admin-content": "node ./tools/admin/import-content.ts --validate-only",
    "check:data": "node ./tools/check-data.mjs",
    "check:assets": "node ./tools/check-assets.mjs",
    "check:routes": "node ./tools/check-routes.mjs",
    "check:css-vars": "node ./tools/check-css-vars.mjs",
    "check:css-modules": "node ./tools/check-css-modules.mjs",
    "smoke": "node ./tools/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:source && npm run check:encoding && npm run check:privacy && npm run check:admin-security && npm run check:admin-content && npm run check:data && npm run check:assets && npm run check:routes && npm run check:css-vars && npm run check:css-modules && npm run build && npm run smoke",
    "audit:deps": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:scan": "node ./tools/security-audit.mjs",
    "images:strip-metadata": "node ./tools/strip-webp-metadata.mjs",
    "build:secure": "node ./tools/build-secure-deploy.mjs"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
