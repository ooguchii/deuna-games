# Entorno exclusivo del worker multimedia aislado.
# No colocar credenciales de PostgreSQL, sesiones ni secretos del panel aquí.

DEUNA_MEDIA_IMPORT_WORKER_PORT=3101

# Generar un token aleatorio de al menos 32 caracteres y repetir exactamente
# el mismo valor en /etc/deuna-games/runtime.env.
DEUNA_MEDIA_IMPORT_WORKER_TOKEN=

# El worker invoca un wrapper que habilita Node y el componente oficial
# ejs:github de yt-dlp para resolver los desafíos JavaScript de YouTube.
# Para previews editoriales DeUna prioriza web_embedded, que no requiere PO
# Token en videos embebibles, y deja los clientes automáticos como fallback.
# El alias auto conserva esa estrategia. Sólo fijar otro valor para una
# investigación puntual; por ejemplo mweb cuando exista un PO Token Provider.
DEUNA_YTDLP_PATH=/usr/local/lib/deuna-games/yt-dlp-node-wrapper.sh
DEUNA_YTDLP_BINARY=/usr/bin/yt-dlp
DEUNA_NODE_BINARY=/usr/bin/node
DEUNA_YTDLP_YOUTUBE_CLIENTS=auto

# Opcional. Sólo si YouTube exige una sesión real (edad, contenido privado,
# miembros, etc.). Para videos públicos bloqueados por Proof-of-Origin se
# recomienda un PO Token Provider antes que reutilizar una cuenta personal.
# Debe ser un archivo Netscape legible únicamente por el usuario del worker.
# Nunca almacenar este archivo dentro del repositorio o del directorio público.
DEUNA_YTDLP_COOKIES_FILE=
