# EJEMPLO SIN SECRETOS para /etc/deuna-games/media-import.env
# Instalar como root:root 0600. El token real NO se versiona.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Puerto fijo sólo en loopback. No publicar en firewall/Nginx.
DEUNA_MEDIA_IMPORT_WORKER_PORT=3101

# Generar un valor aleatorio diferente de cualquier contraseña, por ejemplo:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# El mismo valor debe ir en DEUNA_MEDIA_IMPORT_WORKER_TOKEN del runtime web.
DEUNA_MEDIA_IMPORT_WORKER_TOKEN=

# yt-dlp se usa únicamente dentro de este worker para importar el tramo elegido
# de un video de YouTube. Mantenerlo actualizado porque YouTube cambia seguido.
DEUNA_YTDLP_PATH=/usr/local/bin/yt-dlp
