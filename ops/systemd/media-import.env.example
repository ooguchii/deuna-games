# Entorno exclusivo del worker multimedia aislado.
# No colocar credenciales de PostgreSQL, sesiones ni secretos del panel aquí.

DEUNA_MEDIA_IMPORT_WORKER_PORT=3101

# Generar un token aleatorio de al menos 32 caracteres y repetir exactamente
# el mismo valor en /etc/deuna-games/runtime.env.
DEUNA_MEDIA_IMPORT_WORKER_TOKEN=

# Ruta de yt-dlp usada para YouTube, Facebook, Instagram, TikTok, Vimeo,
# X/Twitter, Twitch, Dailymotion, Streamable y Kick cuando el extractor lo permita.
DEUNA_YTDLP_PATH=/usr/bin/yt-dlp
