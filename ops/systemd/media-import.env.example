# Entorno exclusivo del worker multimedia aislado.
# No colocar credenciales de PostgreSQL, sesiones ni secretos del panel aquí.

DEUNA_MEDIA_IMPORT_WORKER_PORT=3101

# Generar un token aleatorio de al menos 32 caracteres y repetir exactamente
# el mismo valor en /etc/deuna-games/runtime.env.
DEUNA_MEDIA_IMPORT_WORKER_TOKEN=

# El worker invoca un wrapper que fija una ruta absoluta para Node y habilita
# el componente EJS de yt-dlp necesario para los desafíos JavaScript de YouTube.
#
# En modo auto NO se fuerza ningún player_client: el primer intento deja que
# yt-dlp moderno elija sus clientes vigentes. Si ese intento falla, DeUna hace
# un segundo intento aislado con web_embedded, apropiado para videos que YouTube
# permite embeber. Sólo fijar DEUNA_YTDLP_YOUTUBE_CLIENTS para una investigación
# puntual de una regresión upstream.
#
# Mantener yt-dlp actualizado es parte del servicio. A septiembre de 2026 la
# estable vigente es 2026.08.19; versiones antiguas pueden no entender EJS o los
# clientes actuales de YouTube.
DEUNA_YTDLP_PATH=/usr/local/lib/deuna-games/yt-dlp-node-wrapper.sh
DEUNA_YTDLP_BINARY=/usr/bin/yt-dlp
DEUNA_NODE_BINARY=/usr/bin/node
DEUNA_YTDLP_JS_RUNTIME=node
DEUNA_YTDLP_REMOTE_COMPONENT=ejs:github
DEUNA_YTDLP_YOUTUBE_CLIENTS=auto

# Opcional. Sólo si una plataforma exige una sesión real (edad, contenido
# privado, miembros, etc.). Debe ser un archivo Netscape legible únicamente
# por el usuario del worker. Para bloqueos Proof-of-Origin de YouTube se
# recomienda un PO Token Provider compatible antes que reutilizar una cuenta
# personal. Nunca guardar este archivo dentro del repositorio o public/.
DEUNA_YTDLP_COOKIES_FILE=

# Diagnóstico completo sólo en journalctl; nunca se devuelve crudo al panel.
# Activarlo temporalmente durante una investigación y volverlo a 0 después.
DEUNA_YTDLP_DIAGNOSTICS=0
