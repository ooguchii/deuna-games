# EJEMPLO SIN SECRETOS.
# El archivo real se instala como /etc/deuna-games/runtime.env,
# pertenece a root y usa modo 0600. Nunca se versiona.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Origen público real usado para metadata, sitemap y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=https://games.example.com

# Cuentas públicas. El correo es opcional y sólo puede persistirse cifrado.
# DEUNA_ACCOUNT_DATA_KEY debe ser una clave base64url aleatoria de 32 bytes,
# diferente de cualquier contraseña o secreto de PostgreSQL.
DEUNA_ACCOUNT_DATA_KEY=
DEUNA_ACCOUNT_SESSION_DAYS=30

# Mantener false hasta terminar PostgreSQL, propietario, VPN, HTTPS,
# Nginx y los dos preflight. Cambiar a true como último paso.
DEUNA_ADMIN_ENABLED=false
DEUNA_ADMIN_SESSION_HOURS=8
DEUNA_ADMIN_ORIGIN=https://games.example.com

# Multimedia editorial subida desde el panel.
# Debe quedar fuera de /srv/deuna-games/current y sobrevivir a releases nuevas.
# El servicio systemd de ejemplo permite escritura en /var/lib/deuna-games.
DEUNA_EDITORIAL_MEDIA_ROOT=/var/lib/deuna-games/editorial-media

# PostgreSQL en el mismo VPS. El rol runtime no puede migrar ni crear tablas;
# sólo recibe permisos mínimos explícitos. DELETE queda limitado a la baja
# autónoma de cuentas públicas y a la rotación de códigos de recuperación.
DEUNA_DATABASE_HOST=127.0.0.1
DEUNA_DATABASE_PORT=5432
DEUNA_DATABASE_NAME=deuna_games
DEUNA_DATABASE_USER=deuna_runtime
DEUNA_DATABASE_PASSWORD=
DEUNA_DATABASE_SSL=false
