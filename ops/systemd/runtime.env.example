# EJEMPLO SIN SECRETOS.
# El archivo real se instala como /etc/deuna-games/runtime.env,
# pertenece a root y usa modo 0600. Nunca se versiona.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Origen público real usado para metadata, sitemap y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=https://games.example.com

# Mantener false hasta terminar PostgreSQL, propietario, VPN, HTTPS,
# Nginx y los dos preflight. Cambiar a true como último paso.
DEUNA_ADMIN_ENABLED=false
DEUNA_ADMIN_SESSION_HOURS=8
DEUNA_ADMIN_ORIGIN=https://games.example.com

# PostgreSQL en el mismo VPS. Este rol no puede migrar ni borrar datos.
DEUNA_DATABASE_HOST=127.0.0.1
DEUNA_DATABASE_PORT=5432
DEUNA_DATABASE_NAME=deuna_games
DEUNA_DATABASE_USER=deuna_runtime
DEUNA_DATABASE_PASSWORD=
DEUNA_DATABASE_SSL=false
