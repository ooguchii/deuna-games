# Copiar como .env.admin-migration.local en la raíz del repositorio privado.
# Next.js no carga ese nombre. Eliminarlo del VPS si ya no se necesita.
NODE_ENV=production

DEUNA_DATABASE_HOST=127.0.0.1
DEUNA_DATABASE_PORT=5432
DEUNA_DATABASE_NAME=deuna_games
DEUNA_DATABASE_SSL=false

# Sólo se necesita el nombre del rol runtime para aplicar sus permisos mínimos.
# Su contraseña pertenece exclusivamente a .env.local y no se repite aquí.
DEUNA_DATABASE_USER=deuna_runtime

DEUNA_DATABASE_MIGRATION_USER=deuna_migrator
DEUNA_DATABASE_MIGRATION_PASSWORD=
