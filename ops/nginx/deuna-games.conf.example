# EJEMPLO - NO copiar sin adaptar dominio/certificados.
#
# El proceso Next debe escuchar sólo en 127.0.0.1:3000.
#
# Política privacy-first:
# - no se reenvía la IP real del visitante a la aplicación;
# - access_log queda desactivado;
# - error_log se descarta para no persistir direcciones en diagnósticos;
# - el rate limiting puede seguir usando $binary_remote_addr en Nginx
#   sin entregar ese dato a Next.
#
# Este archivo debe incluirse desde el contexto http {} de Nginx (como ocurre
# normalmente con sites-enabled). Estas zonas son obligatorias porque las
# ubicaciones protegidas las referencian más abajo.
limit_req_zone $binary_remote_addr zone=deuna_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=deuna_admin_login:1m rate=5r/m;
limit_req_zone $binary_remote_addr zone=deuna_admin_api:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=deuna_account_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=deuna_account_api:10m rate=60r/m;

# Las zonas de administración usan la IP únicamente en memoria para permitir
# acceso desde la VPN y limitar ataques. No se registra ni se reenvía a Next.

server {
    listen 80;
    listen [::]:80;

    server_name example.com www.example.com;

    access_log off;
    error_log /dev/null crit;

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name example.com www.example.com;

    server_tokens off;

    access_log off;
    error_log /dev/null crit;

    ssl_certificate     /RUTA/CERTIFICADO/fullchain.pem;
    ssl_certificate_key /RUTA/CERTIFICADO/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 1m;
    limit_req_status 429;

    # Activar HSTS SOLAMENTE cuando HTTPS ya esté probado y sea permanente.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Panel privado. Cambiar 10.8.0.0/24 si WireGuard utiliza otra subred.
    # Estas ubicaciones deben permanecer ANTES de location /.
    location = /admin {
        allow 10.8.0.0/24;
        deny all;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ^~ /admin/ {
        allow 10.8.0.0/24;
        deny all;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location = /api/admin/auth/login {
        allow 10.8.0.0/24;
        deny all;

        limit_req zone=deuna_admin_login burst=5 nodelay;
        client_max_body_size 8k;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Únicas excepciones de carga grande: el administrador puede enviar un video
    # fuente de hasta 1 GiB para guardarlo directamente o para crear el proxy de
    # edición cuando el navegador no entiende el códec. Nginx no almacena el body
    # completo antes de pasarlo a Next: ambos endpoints escriben por streaming en
    # un archivo temporal 0600 y eliminan los temporales al terminar.
    location ~ "^/api/admin/content/games/[a-z0-9][a-z0-9._-]{0,159}/(preview-upload|preview-source-upload)$" {
        allow 10.8.0.0/24;
        deny all;

        limit_req zone=deuna_admin_api burst=4 nodelay;
        client_max_body_size 1024m;
        proxy_request_buffering off;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # No usar ^~ aquí: necesitamos que la excepción regex de cargas multimedia
    # anterior pueda ganar antes de aplicar el límite pequeño general.
    location /api/admin/ {
        allow 10.8.0.0/24;
        deny all;

        limit_req zone=deuna_admin_api burst=20 nodelay;
        client_max_body_size 8k;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Autenticación pública: el identificador de red sólo vive en la zona de
    # memoria compartida de Nginx. No se registra ni se entrega a Next. El
    # burst admite varios usuarios detrás de una misma red sin dejar el KDF de
    # contraseñas expuesto a solicitudes ilimitadas.
    location ~ ^/api/account/(login|register|recover)$ {
        limit_req zone=deuna_account_auth burst=12 nodelay;
        client_max_body_size 20k;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 20s;
        proxy_read_timeout 20s;
    }

    # Acciones autenticadas de Mi DeUna. Un límite separado evita que una
    # ráfaga legítima del dashboard consuma el presupuesto del login.
    location /api/account/ {
        limit_req zone=deuna_account_api burst=30 nodelay;
        client_max_body_size 20k;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 20s;
        proxy_read_timeout 20s;
    }

    location / {
        # Si configuraste limit_req_zone en http{}:
        # limit_req zone=deuna_general burst=40 nodelay;

        proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No reenviar X-Real-IP / X-Forwarded-For: la aplicación
        # no necesita conocer la dirección real del visitante.

        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
