# Este valor es PÚBLICO por diseño.
# Desarrollo local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Producción / build:secure:
# - usar el origen HTTPS real, por ejemplo https://games.example.com
# - no agregar ruta, query, fragmento, usuario ni contraseña
#
# Nunca pongas passwords/tokens/secretos con prefijo NEXT_PUBLIC_.

# Cuentas públicas con minimización de datos.
# El correo es opcional. Si el usuario decide agregarlo, se cifra con esta
# clave privada de 32 bytes codificada como base64url.
# Generar una clave nueva, por ejemplo:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Nunca versionar el valor real ni reutilizar una contraseña como clave.
DEUNA_ACCOUNT_DATA_KEY=
DEUNA_ACCOUNT_SESSION_DAYS=30

# Interruptor de creación de NUEVAS cuentas.
# - desarrollo/test: puede usarse true;
# - producción: si la variable falta, el código cierra el registro por defecto;
# - no usar true públicamente hasta completar la información jurídica,
#   contacto de privacidad, jurisdicción, retención de backups y términos aplicables.
# Login y recuperación de cuentas existentes continúan funcionando aunque sea false.
DEUNA_ACCOUNT_REGISTRATION_ENABLED=true

# Panel administrativo privado. Mantener false hasta completar PostgreSQL,
# la cuenta propietaria, HTTPS y el acceso exclusivo mediante VPN.
DEUNA_ADMIN_ENABLED=false
DEUNA_ADMIN_SESSION_HOURS=8
# Origen exacto desde el que se abre el panel. En producción debe usar HTTPS.
DEUNA_ADMIN_ORIGIN=http://localhost:3000

# Almacén persistente para WebP y WebM generados desde el panel.
# Debe ser una ruta absoluta FUERA del directorio desplegado de la aplicación.
# Con el servicio systemd de ejemplo, usar:
# DEUNA_EDITORIAL_MEDIA_ROOT=/var/lib/deuna-games/editorial-media
DEUNA_EDITORIAL_MEDIA_ROOT=

# Conversión de previews de tarjetas. DeUna usa FFmpeg para aceptar formatos
# comunes y producir WebM/VP9 de hasta 30 s, sin audio y optimizado para cards.
# Si "ffmpeg" ya está disponible en PATH, dejar vacío. Si no, indicar la ruta
# absoluta al ejecutable (en Windows puede apuntar a ffmpeg.exe).
DEUNA_FFMPEG_PATH=

# En desarrollo, los enlaces públicos de YouTube/Facebook/Instagram/TikTok/etc.
# usan yt-dlp. Si "yt-dlp" está en PATH puede dejarse DEUNA_YTDLP_PATH vacío.
# El launcher de desarrollo pasa por el mismo wrapper normalizado que producción
# para mantener la política de extracción alineada.
#
# YouTube necesita resolver desafíos JavaScript. El wrapper habilita Node y el
# componente oficial ejs:github recomendado por yt-dlp. Desde agosto de 2026 no
# se fuerza web_embedded por defecto: yt-dlp moderno decide dinámicamente el
# cliente y sus fallbacks. Sólo configura DEUNA_YTDLP_YOUTUBE_CLIENTS para una
# prueba puntual si una regresión futura de upstream lo requiere.
#
# Si YouTube cambia el extractor, mantener yt-dlp actualizado es parte del
# servicio. DEUNA_YTDLP_COOKIES_FILE es opcional y sólo debe apuntar a un archivo
# Netscape privado cuando la plataforma exija una sesión real.
# Nunca versionar ese archivo ni colocarlo dentro de public/.
# En producción yt-dlp debe vivir sólo en el worker multimedia aislado.
DEUNA_YTDLP_PATH=
DEUNA_YTDLP_JS_RUNTIME=node
DEUNA_YTDLP_REMOTE_COMPONENT=ejs:github
DEUNA_YTDLP_YOUTUBE_CLIENTS=auto
DEUNA_YTDLP_COOKIES_FILE=
# En desarrollo el diagnóstico real de yt-dlp se imprime automáticamente.
# En producción sólo activar temporalmente si se necesita investigar un fallo.
DEUNA_YTDLP_DIAGNOSTICS=0

# Producción: el runtime web no sale a Internet. Las URLs externas se importan
# mediante un worker HTTP autenticado que escucha sólo en loopback.
# En desarrollo pueden quedar vacías: `npm run dev`, `npm run lan` y
# `npm run mobile:secure` levantan un worker efímero con puerto dinámico y token
# aleatorio sólo para esa ejecución. Configúralas manualmente únicamente si
# querés reutilizar un worker local propio.
DEUNA_MEDIA_IMPORT_WORKER_URL=
DEUNA_MEDIA_IMPORT_WORKER_TOKEN=

# PostgreSQL autogestionado. El proceso web usa un rol runtime sin permisos
# para crear o modificar tablas.
DEUNA_DATABASE_HOST=127.0.0.1
DEUNA_DATABASE_PORT=5432
DEUNA_DATABASE_NAME=deuna_games
DEUNA_DATABASE_USER=deuna_runtime
DEUNA_DATABASE_PASSWORD=
DEUNA_DATABASE_SSL=false
